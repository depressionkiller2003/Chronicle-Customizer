+#pragma once
+
+#include <array>
+#include <string_view>
+
+namespace mods::customizer {
+struct Character {
+    std::string_view key, name;
+};
+
+inline constexpr std::array<Character, 6> characters{{
+    {"toan", "Toan"}, {"xiao", "Xiao"}, {"goro", "Goro"},
+    {"ruby", "Ruby"}, {"ungaga", "Ungaga"}, {"osmond", "Osmond"},
+}};
+
+inline constexpr bool CharacterUnlocked(int character, int party_size) {
+    return character >= 0 && character < static_cast<int>(characters.size()) && character < party_size;
+}
+
+struct NumericAction {
+    std::string_view id, prompt;
+    int minimum, maximum;
+};
+
+inline constexpr std::array<NumericAction, 13> actions{{
+    {"custom_gilda", "Enter Gilda: ", 1, 65535},
+    {"toan_hp", "Enter Toan HP: ", 1, 32767},
+    {"toan_def", "Enter Toan DEF: ", 0, 32767},
+    {"xiao_hp", "Enter Xiao HP: ", 1, 32767},
+    {"xiao_def", "Enter Xiao DEF: ", 0, 32767},
+    {"goro_hp", "Enter Goro HP: ", 1, 32767},
+    {"goro_def", "Enter Goro DEF: ", 0, 32767},
+    {"ruby_hp", "Enter Ruby HP: ", 1, 32767},
+    {"ruby_def", "Enter Ruby DEF: ", 0, 32767},
+    {"ungaga_hp", "Enter Ungaga HP: ", 1, 32767},
+    {"ungaga_def", "Enter Ungaga DEF: ", 0, 32767},
+    {"osmond_hp", "Enter Osmond HP: ", 1, 32767},
+    {"osmond_def", "Enter Osmond DEF: ", 0, 32767},
+}};
+
+inline const NumericAction *Find(std::string_view id) {
+    for (const auto &action : actions) {
+        if (action.id == id) {
+            return &action;
+        }
+    }
+    return nullptr;
+}
+
+inline bool IsNumericRequest(std::string_view owner, std::string_view id) {
+    const auto separator = id.find(':');
+    return owner == "chronicle.customizer" && separator != std::string_view::npos && Find(id.substr(0, separator));
+}
+} // namespace mods::customizer
