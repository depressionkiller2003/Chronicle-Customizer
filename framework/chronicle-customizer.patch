@@ -0,0 +1,35 @@
+#include "mods/customizer.hpp"
+
+#include <cassert>
+#include <string>
+
+int main() {
+    using namespace mods::customizer;
+    assert(actions.size() == 13);
+    for (int joined = 0; joined <= 6; ++joined) {
+        for (int character = 0; character < 6; ++character) {
+            assert(CharacterUnlocked(character, joined) == (character < joined));
+        }
+    }
+    assert(!CharacterUnlocked(-1, 6));
+    assert(!CharacterUnlocked(6, 7));
+    assert(!CharacterUnlocked(0, -1));
+    const std::array<std::string_view, 6> expected{"toan", "xiao", "goro", "ruby", "ungaga", "osmond"};
+    for (std::size_t i = 0; i < characters.size(); ++i) {
+        assert(characters[i].key == expected[i]);
+        assert(Find(std::string(characters[i].key) + "_hp"));
+        assert(Find(std::string(characters[i].key) + "_def"));
+    }
+    for (const auto &action : actions) {
+        assert(Find(action.id) == &action);
+        assert(action.minimum == (action.id.ends_with("_def") ? 0 : 1));
+        assert(action.maximum == (action.id == "custom_gilda" ? 65535 : 32767));
+        const auto request = std::string(action.id) + ":123";
+        assert(IsNumericRequest("chronicle.customizer", request));
+        assert(!IsNumericRequest("other.mod", request));
+        assert(!IsNumericRequest("chronicle.customizer", action.id));
+    }
+    assert(!Find("unknown_hp"));
+    assert(!IsNumericRequest("chronicle.customizer", "unknown_hp:123"));
+    assert(!IsNumericRequest("chronicle.customizer", "xiao_hp_extra:123"));
+}
