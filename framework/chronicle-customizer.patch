--- /dev/null
+++ b/examples/mods/chronicle-customizer/README.md
@@ -0,0 +1,20 @@
+# Chronicle Customizer
+
+Source package for `chronicle.customizer` version `1.0.0`, paired with the native
+Customizer support in this fork of Chronicle. No game data is included.
+
+Provides Custom Gilda and HP/DEF editing for Toan, Xiao, Goro, Ruby, Ungaga and
+Osmond. The host groups the 13 actions into six ordered character folders plus
+Custom Gilda and locks unrecruited characters. Enabling this package also enables
+the native weapon menu's tree preview and revealed build-up destination names.
+
+Copy this directory to `mods/chronicle.customizer` beside the built executable
+or into your chosen save root's `mods` directory. Enable it in **Options → Mods →
+Mod Manager** and restart. Avoid duplicate installed copies.
+
+This package uses `economy.write` and `game.write`, and requires `menu.actions.v1`.
+It is not compatible with an unmodified upstream host that lacks this fork's
+numeric-input and native menu integration.
+
+Read the [complete guide](../../../docs/CHRONICLE_CUSTOMIZER.md) for controls,
+input ranges, save behavior, validation and remaining gameplay checks.
diff --git a/examples/mods/chronicle-customizer/main.lua b/examples/mods/chronicle-customizer/main.lua
new file mode 100644
index 0000000000000000000000000000000000000000..2f1fc5dc086b0bdd16800555829539c7f55cd6d7
--- /dev/null
+++ b/examples/mods/chronicle-customizer/main.lua
@@ -0,0 +1,49 @@
+local mod = {}
+
+chronicle.action(
+    "custom_gilda",
+    "Custom Gilda",
+    "Enter an amount to add to your Gilda balance.",
+    function(world)
+        local amount = tonumber(chronicle.get("custom_gilda_amount")) or 0
+
+        if amount < 1 or amount > 65535 then
+            return
+        end
+
+        local remaining = amount
+
+        while remaining > 0 do
+            local chunk = math.min(remaining, 32767)
+            chronicle.add_money(chunk)
+            remaining = remaining - chunk
+        end
+    end
+)
+
+-- Each registration is a direct action in the same flat menu.
+-- Capture each character in this function so callbacks keep their own ID.
+local function register_character(id, key, name)
+    chronicle.action(key .. "_hp", name .. " - HP", "Set " .. name .. "'s maximum HP (1-32767). Requires a joined character; does not heal.", function(world)
+        local value = tonumber(chronicle.get(key .. "_hp_amount"))
+        if value and value >= 1 and value <= 32767 then
+            chronicle.call("player.max_hp_set", {character = id, max_hp = math.floor(value)})
+        end
+    end)
+
+    chronicle.action(key .. "_def", name .. " - DEF", "Set " .. name .. "'s defense (0-32767). Requires a joined character.", function(world)
+        local value = tonumber(chronicle.get(key .. "_def_amount"))
+        if value and value >= 0 and value <= 32767 then
+            chronicle.call("player.defense_set", {character = id, defense = math.floor(value)})
+        end
+    end)
+end
+
+register_character(0, "toan", "Toan")
+register_character(1, "xiao", "Xiao")
+register_character(2, "goro", "Goro")
+register_character(3, "ruby", "Ruby")
+register_character(4, "ungaga", "Ungaga")
+register_character(5, "osmond", "Osmond")
+
+return mod
