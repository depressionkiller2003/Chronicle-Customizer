+
+namespace mods::weapons {
+namespace {
+constexpr const char *owner = "chronicle.customizer";
+std::string Name(int item) {
+    return btlmenu_detail::DecodeItemNamePort(item, "Weapon #" + std::to_string(item));
+}
+
+ActionStatus Message(std::string text) {
+    return {owner, "inspect:message", "Build-up Tree", std::move(text), {}, false};
+}
+
+} // namespace
+
+bool TreeEnabled() {
+    return !Scripts().Actions(owner).empty();
+}
+
+bool HandleTreeAction(int options) {
+    if (!TreeEnabled() || WepMenu.state != WEP_STATE_IDLE) return false;
+    const auto rows = ActionRows(options, true);
+    const auto found = std::find(rows.begin(), rows.end(), WepMenu.board.cursor);
+    if (GamePad.Down(PAD_UP | PAD_DOWN)) {
+        int index = found == rows.end() ? 0 : static_cast<int>(found - rows.begin());
+        index = (index + (GamePad.Down(PAD_UP) ? -1 : 1) + static_cast<int>(rows.size())) % static_cast<int>(rows.size());
+        WepMenu.board.cursor = rows[index];
+        return true;
+    }
+    if (WepMenu.board.cursor == TreeAction && GamePad.Down(PAD_CROSS)) {
+        menu::OpenWeaponTree(WepMenu.chara, WepMenu.weapon_slot);
+        ComMenuSePlay(MENU_SOUND_CONFIRM);
+        return true;
+    }
+    return false;
+}
+
+std::vector<ActionStatus> Tree(int character, int slot) {
+    if (!customizer::CharacterUnlocked(character, JoinedCharacterCount()) || slot < 0 || slot >= 11) {
+        return {Message("Weapon unavailable. Return to the weapon list.")};
+    }
+    const auto &s = *SaveData->GetDngStatus();
+    auto held = s.chara_weapons[character][slot];
+    if (held.item_no <= ITEM_WEAPON_SLOT_EMPTY || held.item_no >= ITEM_WEAPON_END) {
+        return {Message("That weapon slot is empty. Return to the weapon list.")};
+    }
+    try {
+        const auto nodes = BuildTree(held.item_no, retail::BuildUpTargets);
+        std::vector<ActionStatus> rows;
+        for (const auto &node : nodes) {
+            const auto next = retail::BuildUpTargets(node.item);
+            const auto *d = GetWeaponData(node.item);
+            if (!d || d->owner != character) throw std::runtime_error("Invalid weapon branch owner");
+            std::string body = node.depth == 0
+                ? "SELECTED WEAPON\n" + Name(held.item_no) + "\n\nBUILD-UP TREE\nIndented rows show the future paths. Move up/down to explore each branch."
+                : "FROM\n" + Name(node.parent) + "\n\nBUILDS INTO\n" + Name(node.item);
+            if (node.parent == ITEM_WEAPON_MARDAN_EINS || node.parent == ITEM_WEAPON_MARDAN_TWEI) {
+                body += "\n\nSpecial route: catch " + std::to_string(node.parent == ITEM_WEAPON_MARDAN_EINS ? 5 : 15) + " fish.";
+            }
+            body += "\n\nNEXT BRANCHES";
+            for (int target : next) body += "\n> " + Name(target);
+            if (next.empty()) body += "\nFinal weapon - no further build-up.";
+            if (node.cycle) body += "\nRepeated link: expansion stopped.";
+            if (nodes.size() >= 256) body += "\nTree display limit reached.";
+            body += "\n\nPreview only. Use the normal weapon menu to build up.";
+            rows.push_back({owner, "inspect:" + std::to_string(rows.size()),
+                            std::string(std::min(node.depth, 5) * 2, ' ') + (node.depth ? "> " : "") + Name(node.item),
+                            std::move(body), {}, true});
+        }
+        return rows;
+    } catch (const std::exception &e) {
+        return {Message(std::string("Cannot inspect this weapon: ") + e.what())};
+    }
+}
+} // namespace mods::weapons
