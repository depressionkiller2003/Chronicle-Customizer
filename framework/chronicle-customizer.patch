new file mode 100644
index 0000000000000000000000000000000000000000..922fb2e33b5c9bd930b1a9429cfe73e3cbe26ad7
--- /dev/null
+++ b/.github/workflows/customizer.yml
@@ -0,0 +1,36 @@
+name: Customizer regression checks
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  customizer:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - name: Validate package and author tools
+        run: |
+          python3 tools/chronicle_mod.py check examples/mods/chronicle-customizer
+          python3 -m unittest discover -s tools/tests
+      - name: Check numeric rules, story locks and weapon-tree ordering
+        run: |
+          mkdir -p build/customizer-checks
+          clang++ -std=c++20 -I port/src tools/tests/customizer_numeric.cpp -o build/customizer-checks/numeric
+          clang++ -std=c++20 -I port/src tools/tests/customizer_weapon_tree.cpp -o build/customizer-checks/tree
+          build/customizer-checks/numeric
+          build/customizer-checks/tree
+      - name: Check actual package callbacks with vendored Lua
+        shell: bash
+        run: |
+          sources=()
+          for source in port/third_party/lua/*.c; do
+            if [[ "$source" != */luac.c ]]; then sources+=("$source"); fi
+          done
+          clang -O2 -DLUA_USE_LINUX "${sources[@]}" -lm -ldl -o build/customizer-checks/lua
+          build/customizer-checks/lua tools/tests/customizer_actions.lua
