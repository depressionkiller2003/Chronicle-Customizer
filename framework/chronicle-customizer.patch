+        assert(not actions[id], "duplicate action: " .. id)
+        actions[id] = {title = title, run = callback}
+    end,
+    get = function(key) return values[key] end,
+    call = function(operation, arguments)
+        calls[#calls + 1] = {operation = operation, arguments = arguments}
+    end,
+    add_money = function(amount)
+        assert(math.type(amount) == "integer" and amount >= 1 and amount <= 32767)
+        money = money + amount
+    end,
+}
+dofile(arg[1] or "examples/mods/chronicle-customizer/main.lua")
+local count = 0
+for _ in pairs(actions) do count = count + 1 end
+assert(count == 13)
+
+local names = {"Toan", "Xiao", "Goro", "Ruby", "Ungaga", "Osmond"}
+for index, name in ipairs(names) do
+    for _, stat in ipairs({"hp", "def"}) do
+        local key = name:lower() .. "_" .. stat
+        local field = stat == "hp" and "max_hp" or "defense"
+        local operation = "player." .. field .. "_set"
+        local minimum = stat == "hp" and 1 or 0
+        assert(actions[key].title == name .. " - " .. stat:upper())
+        for _, value in ipairs({minimum, 123.75, 32767, "456"}) do
+            values[key .. "_amount"] = value
+            calls = {}
+            actions[key].run({})
+            assert(#calls == 1, key)
+            local args = calls[1].arguments
+            assert(calls[1].operation == operation, key)
+            assert(args.character == index - 1, key)
+            assert(args[field] == math.floor(tonumber(value)), key)
+            assert(math.type(args[field]) == "integer", key)
+        end
+        for _, invalid in ipairs({minimum - 1, 32768, "invalid", false}) do
+            values[key .. "_amount"] = invalid
+            calls = {}
+            actions[key].run({})
+            assert(#calls == 0, key)
+        end
+        values[key .. "_amount"] = nil
+        actions[key].run({})
+        assert(#calls == 0, key)
+    end
+end
+for _, amount in ipairs({1, 32767, 32768, 65535}) do
+    values.custom_gilda_amount = amount
+    money = 0
+    actions.custom_gilda.run({})
+    assert(money == amount)
+end
+for _, amount in ipairs({0, -1, 65536, "invalid"}) do
+    values.custom_gilda_amount = amount
+    money = 0
+    actions.custom_gilda.run({})
+    assert(money == 0)
+end
+print("PASS: 13 registered actions; six character targets; integer HP/DEF; bounds; Gilda chunking")
