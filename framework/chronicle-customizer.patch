diff --git a/port/src/mods/weapon_tree.hpp b/port/src/mods/weapon_tree.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..cd3496aaa9e6cac976a09734544a77bef6c06d94
--- /dev/null
+++ b/port/src/mods/weapon_tree.hpp
@@ -0,0 +1,39 @@
+#pragma once
+#include <algorithm>
+#include <functional>
+#include <vector>
+
+namespace mods::weapons {
+inline constexpr int TreeAction = 7;
+
+inline std::vector<int> ActionRows(int options, bool tree_enabled) {
+    std::vector<int> rows{0, 1, 2, 3};
+    for (int bit = 1; bit <= 3; ++bit) {
+        if (options & (1 << bit)) rows.push_back(bit + 3);
+    }
+    if (tree_enabled) rows.push_back(TreeAction);
+    return rows;
+}
+
+struct TreeNode {
+    int item, parent, depth;
+    bool cycle;
+};
+
+// Keep merged branches visible, but stop cycles and bound work for malformed data.
+inline std::vector<TreeNode> BuildTree(int root, const std::function<std::vector<int>(int)> &targets) {
+    std::vector<TreeNode> nodes;
+    std::vector<int> path;
+    const auto visit = [&](auto &&self, int item, int parent, int depth) -> void {
+        if (nodes.size() >= 256 || depth > 32) return;
+        const bool cycle = std::find(path.begin(), path.end(), item) != path.end();
+        nodes.push_back({item, parent, depth, cycle});
+        if (cycle) return;
+        path.push_back(item);
+        for (int next : targets(item)) self(self, next, item, depth + 1);
+        path.pop_back();
+    };
+    visit(visit, root, -1, 0);
+    return nodes;
+}
+} // namespace mods::weapons
