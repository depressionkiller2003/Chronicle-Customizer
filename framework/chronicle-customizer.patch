--- /dev/null
+++ b/tools/tests/customizer_weapon_tree.cpp
@@ -0,0 +1,29 @@
+#include "mods/weapon_tree.hpp"
+#include <cassert>
+#include <map>
+
+int main() {
+    using mods::weapons::BuildTree;
+    for (int mask = 0; mask < 8; ++mask) {
+        const auto normal = mods::weapons::ActionRows(mask << 1, false);
+        const auto extended = mods::weapons::ActionRows(mask << 1, true);
+        assert(extended.size() == normal.size() + 1);
+        assert(extended.back() == mods::weapons::TreeAction);
+        assert(std::equal(normal.begin(), normal.end(), extended.begin()));
+        for (int i = 0; i < 4; ++i) assert(normal[i] == i);
+    }
+    std::map<int, std::vector<int>> links{{1, {2, 3}}, {2, {4}}, {3, {4}}};
+    auto tree = BuildTree(1, [&](int item) { return links[item]; });
+    assert(tree.size() == 5);
+    assert(tree[0].item == 1 && tree[0].depth == 0 && tree[0].parent == -1);
+    assert(tree[1].item == 2 && tree[1].parent == 1 && tree[1].depth == 1);
+    assert(tree[2].item == 4 && tree[2].parent == 2 && tree[2].depth == 2);
+    assert(tree[3].item == 3 && tree[4].item == 4 && tree[4].parent == 3);
+    assert(BuildTree(9, [](int) { return std::vector<int>{}; }).size() == 1);
+    tree = BuildTree(1, [](int item) { return std::vector<int>{item == 1 ? 2 : 1}; });
+    assert(tree.size() == 3 && tree.back().cycle);
+    tree = BuildTree(1, [](int item) { return std::vector<int>{item + 1}; });
+    assert(tree.size() == 33);
+    tree = BuildTree(1, [](int item) { return std::vector<int>{item + 1, item + 2}; });
+    assert(tree.size() == 256);
+}
